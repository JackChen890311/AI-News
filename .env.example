# 複製成 .env（或直接 export）來覆蓋預設值。全部都有預設，可以一個都不設。

# ---- 摘要引擎（預設用本機 OpenCode CLI，不需要 API key）----
AI_NEWS_PROVIDER=opencode                          # opencode | api
AI_NEWS_MODEL=opencode/deepseek-v4.1-flash-free    # opencode zen 的模型 ID
# AI_NEWS_OPENCODE_BIN=/path/to/opencode           # 找不到 opencode 時指定絕對路徑

# ---- 若改用 OpenAI 相容 API（provider=api 時需要）----
# AI_NEWS_API_BASE=https://api.openai.com/v1
# AI_NEWS_API_KEY=sk-...

# ---- Gemini（雲端排程用；本機也可以）----
# AI_NEWS_PROVIDER=api
# AI_NEWS_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_NEWS_API_KEY=...                     # 從 https://aistudio.google.com/apikey 取得，別 commit
# AI_NEWS_MODEL=gemini-3.5-flash-lite     # 或 gemini-3.5-flash

# ---- API 失敗重試（免費層很需要）----
# AI_NEWS_API_RETRIES=4                   # 同一個模型最多重試幾次
# AI_NEWS_API_RETRY_BASE=2.0              # 指數退避起始秒數（2, 4, 8, 16…）
# AI_NEWS_API_RETRY_MAX=30                # 單次等待上限（秒）
# AI_NEWS_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash   # 用完就換下一個
# AI_NEWS_JSON_RETRIES=2                  # 回覆不是 JSON 時，同模型降溫重試次數
# AI_NEWS_MAX_TOKENS=2048                 # 單篇輸出上限（推理模型要把 thinking 算進去）
# AI_NEWS_TIME_BUDGET=780                 # 全域時間預算（秒）；GitHub Actions 建議 780
# AI_NEWS_JSON_MODE=1                     # 要求 response_format=json_object（不支援會自動關）

# ---- 行為調整 ----
# AI_NEWS_DEDUP_DAYS=14        # 跨日去重天數（URL 與標題）
# AI_NEWS_TITLE_DEDUP_RATIO=0.82   # 標題相似度門檻；太低會誤殺同公司不同產品
# AI_NEWS_SUMMARY_DEDUP_RATIO=0.65 # 摘要相似度門檻；抓改寫後的同一事件
# AI_NEWS_TITLE_DEDUP=1        # 設 0 關掉標題去重
# AI_NEWS_SUMMARY_DEDUP=1      # 設 0 關掉摘要去重
# AI_NEWS_CONCURRENCY=4        # 平行摘要數
# AI_NEWS_SUMMARY_TIMEOUT=240  # 單篇摘要 timeout（秒）

# ---- 輸出位置 ----
# AI_NEWS_DIGEST_DIR=/path/to/Obsidian/vault/AI-News   # 直接輸出到 Obsidian vault
# AI_NEWS_OBSIDIAN=1                                   # `ai-news open` 改用 obsidian:// 開啟

# ---- launchd 排程（`ai-news install` 用）----
# AI_NEWS_LAUNCHD_LABEL=com.ainews.digest
# AI_NEWS_SCHEDULE_HOUR=8
# AI_NEWS_SCHEDULE_MINUTE=30
